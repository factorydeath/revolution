# Telegram Bot Token
REVOLUTION_BOT_TOKEN=your_bot_token_here
NOREPLY_BOT_TOKEN=your_bot_token_here

# Admin Telegram IDs (separated by commas)
REVOLUTION_ADMIN_IDS=123456789
NOREPLY_ADMIN_IDS=123456789

# XRocket API Key (optional)
XROCKET_API_KEY=your_xrocket_key_here

# VIP prices
VIP_PRICE=100
XROCKET_VIP_PRICE_USDT=2
XROCKET_VIP_PRICE_GRAM=2.2
REVOLUTION_VIP_COMMUNITY_CHAT_ID=-1004422775130

# Performance & Rate Limits
ACTUAL_VIP_RATE_LIMIT=35.0
ACTUAL_DEFAULT_RATE_LIMIT=15.0
HTTP_WORKERS_VIP=6
WORKERS_CAP=8
DELAY_MS=50

# ==============================================================================
# Revolution Autonomous AI Research & Integration Agent Configuration
# ==============================================================================
ANYMODEL_API_KEY=
ANYMODEL_BASE_URL=https://anymodel.org/v1

REASONING_MODEL=am/nemotron-3-ultra-550b-a55b
VISION_MODEL=am/nemotron-3-nano-omni-30b-a3b-reasoning

TARGET_SERVICES=50
MAX_CONCURRENT_TASKS=3

# Web Dashboard (the ONLY control surface for the agent)
AGENT_WEB_HOST=0.0.0.0
AGENT_WEB_PORT=8088
# Password login for the dashboard. If empty, an ephemeral password is generated
# at startup and printed to the agent log (changes every restart).
AGENT_WEB_PASSWORD=change-me
AGENT_WEB_SECRET=
AGENT_WEB_SESSION_TTL_HOURS=168

# Safe Test Probe Numbers
SAFE_PROBE_RU=79373807777
SAFE_PROBE_UA=380678888999

# --- Search layer (multi-provider, proxy-aware, never fabricates results) ---
SEARCH_PROVIDERS=bing_rss,duckduckgo,searxng
SEARXNG_URLS=https://searx.be,https://search.marginalia.nu
SEARCH_TIMEOUT_SEC=15
SEARCH_CONNECT_TIMEOUT_SEC=8
SEARCH_ATTEMPTS_PER_PROVIDER=2
SEARCH_MAX_CONCURRENT=4
SEARCH_RESULTS_PER_QUERY=12
SEARCH_USE_PROXIES=true
SEARCH_PROXY_STRICT=false
SEARCH_PROVIDER_FAIL_THRESHOLD=3
SEARCH_PROVIDER_COOLDOWN_SEC=60

# --- Query planner (cooldowns so the agent stops spinning the same queries) ---
QUERIES_PER_CYCLE=5
CANDIDATES_PER_CYCLE=8
QUERY_COOLDOWN_HOURS=6
CATEGORY_COOLDOWN_MINUTES=30
EMPTY_CYCLE_BACKOFF_SEC=20
MAX_CYCLE_BACKOFF_SEC=600

# --- LLM client (strict JSON, fail-loud — never invents a result) ---
LLM_JSON_MODE=true
LLM_TIMEOUT_SEC=120
LLM_RETRIES=2
LLM_REPAIR_ATTEMPTS=1
# Reasoning model generates diverse search queries across ALL service types
# (streaming/TV, banks, gov, games, crypto, marketplaces...) instead of a fixed list.
LLM_QUERY_PLANNING=true
LLM_QUERY_TEMPERATURE=0.7

# --- Browser (direct connection, no proxy; TLS errors ignored) ---
HEADLESS=true
BROWSER_IGNORE_HTTPS_ERRORS=true
PAGE_TIMEOUT_SEC=30
ACTION_TIMEOUT_SEC=20
MAX_ACTIONS_PER_SITE=25
MAX_BROWSER_CONTEXTS=3
ALLOW_PROBE_SUBMIT=true

# --- Proxy pool (used by search only; browser connects directly) ---
STARTUP_PROXY_CHECK=true
PROXY_HEALTH_TTL_SEC=300
PROXY_MAX_FAILURES=3
PROXY_CHECK_CONCURRENCY=8

# --- Resource guards ---
MAX_CONCURRENT_TASKS=3
CANDIDATE_TIMEOUT_SEC=90
VPS_MAX_MEMORY_PERCENT=85
VPS_MAX_CPU_PERCENT=95


